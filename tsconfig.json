{
  "compilerOptions": {
    "module": "ESNext",
    "target": "esnext",
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "node",
    "outDir": "typings",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "baseUrl": "./src",
    "paths": {
      "k99": ["core/index.d.mts"],
      "k99/services": ["src/services/index.mjs"],
      "k99/node": ["src/node/index.mjs"]
    },
		"verbatimModuleSyntax": true,
    "esModuleInterop": true
  },
  "include": ["src", "test"],
}
