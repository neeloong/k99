    "ln": "mkdir build/node_modules; ln -s .. build/node_modules/k99",
    "cp": "cp LICENSE README.* build",
    "rollup": "rollup -c",
    "lint": "eslint --fix --ext .ts src"
  },
  "dependencies": {
    "entry-cli": "^0.2.0",
    "json5": "^2.2.1",
    "yaml": "^2.1.0"
