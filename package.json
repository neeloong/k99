  "scripts": {
    "build": "npm run tsc && npm run rollup && npm run ln && npm run cp",
    "tsc": "tsc -p tsconfig.json && cp src/core/index.d.mts typings/core/index.d.mts",
    "ln": "mkdir build/node_modules; ln -s .. build/node_modules/k99",
    "cp": "cp LICENSE README.* build",
    "rollup": "rollup -c",
    "lint": "eslint --fix --ext .ts src"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/plugin-transform-typescript": "^7.24.7",
